# Apalchi web — public environment variables (NEXT_PUBLIC_*).
#
# Copy this file to `.env.local` for local development and fill in real values.
# IMPORTANT: NEXT_PUBLIC_* vars are inlined at BUILD time. In production (Vercel)
# you must set them in the project settings AND redeploy — changing them without
# a rebuild has no effect. Never put real secrets here; this file is committed.

# ── Google sign-in (web only) ────────────────────────────────────────────────
# The "Web application" OAuth 2.0 client ID from Google Cloud Console
# (APIs & Services → Credentials). When empty, the Google button is hidden and
# a dev-only console warning is logged. The backend must trust this same ID via
# its GOOGLE_CLIENT_IDS env var, or sign-in will 401 after the popup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL for the Spring Boot backend. Defaults to the Railway production host
# when unset, so you only need this to point at a local/staging backend.
NEXT_PUBLIC_API_URL=https://pallybackend-production.up.railway.app/api/v1

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
# Leave the key empty to disable analytics locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── App store / scheduling links (marketing pages) ───────────────────────────
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=
NEXT_PUBLIC_CALENDLY_URL=

# ── Local development toggles ────────────────────────────────────────────────
# Set to "true" to serve mock data instead of hitting the real API.
NEXT_PUBLIC_USE_MOCK=false
